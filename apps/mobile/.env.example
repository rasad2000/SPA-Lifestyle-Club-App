# Optional mobile/EAS settings. Copy to apps/mobile/.env only when needed.
# Local Expo Go normally needs none of these: it derives the API from Metro's LAN host.

# Public API origin for hosted web/preview/production builds. Required for release builds.
# EXPO_PUBLIC_API_URL=https://api.example.com

# POC/preview only: permit plain HTTP/WSS on native builds. Production should use HTTPS/WSS.
# SPA_ALLOW_CLEARTEXT=1

# EAS project and native identifiers. The default club.spa.garden is a placeholder.
# SPA_EAS_PROJECT_ID=
# SPA_IOS_BUNDLE_ID=club.spa.garden
# SPA_ANDROID_PACKAGE=club.spa.garden
