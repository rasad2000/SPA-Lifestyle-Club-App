# SPA app server — copy to .env (gitignored). Real environment variables override this file.

# Listen address. 0.0.0.0 = LAN + tailnet (the phone/TestFlight build reaches the box directly).
PORT=8790
HOST=0.0.0.0

# SQLite db + uploaded media live here (default: apps/server/data, gitignored).
# DATA_DIR=/var/lib/spa-app

# Bearer token for the producer ingest API (PUT /v1/ingest/...).
# UNSET = ingest disabled (every ingest route answers 503) — the safe default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# INGEST_TOKEN=

# Exported Expo web build (npx expo export -p web). Served at / only if the directory exists.
# WEB_DIR=../mobile/dist

# Club-owned course material (content/courses/<slug>/course.json), validated at startup.
# CONTENT_DIR=content

# Presenter demo: POST /v1/demo/run|reset replay a scripted signal sequence into
# DEMO_CHANNEL for the app's "Demo" header button. Unauthenticated, only ever touches
# posts whose sourceId starts "demo-". POC/demo boxes only, never production.
# DEMO_CONTROLS=1
# DEMO_CHANNEL=gold-desk
